{
  "scopeName": "mathview.javascript",
  "injectionSelector": "L:source.js -comment -string, L:source.ts -comment -string, L:source.tsx -comment -string, L:source.js.jsx -comment -string",
  "comment": "Generated by Math View from its notation settings. Do not edit.",
  "patterns": [
    {
      "match": "(?<![\\w.])(?:(?:numeric|mathjs|lodash|Math|math|d3|ss|tf|nj|_|R)\\.)?(?:prod|sum|max|min)(?=\\s*\\([^\\n]*\\bfor\\b)",
      "name": "support.function.mathview meta.mathview.tall"
    },
    {
      "match": "(?<![\\w.])(?:(?:numeric|mathjs|lodash|Math|math|d3|ss|tf|nj|_|R)\\.)?sumBy(?=\\s*\\()|(?<![\\w.])(?:(?:numeric|mathjs|lodash|Math|math|d3|ss|tf|nj|_|R)\\.)?meanBy(?=\\s*\\()|(?<![\\w.])(?:(?:numeric|mathjs|lodash|Math|math|d3|ss|tf|nj|_|R)\\.)?maxBy(?=\\s*\\()|(?<![\\w.])(?:(?:numeric|mathjs|lodash|Math|math|d3|ss|tf|nj|_|R)\\.)?minBy(?=\\s*\\()|(?<![\\w.])(?:(?:numeric|mathjs|lodash|Math|math|d3|ss|tf|nj|_|R)\\.)?sum(?=\\s*\\()|(?<![\\w.])(?:(?:numeric|mathjs|lodash|Math|math|d3|ss|tf|nj|_|R)\\.)?mean(?=\\s*\\()|(?<![\\w.])(?:(?:numeric|mathjs|lodash|Math|math|d3|ss|tf|nj|_|R)\\.)?max(?=\\s*\\()|(?<![\\w.])(?:(?:numeric|mathjs|lodash|Math|math|d3|ss|tf|nj|_|R)\\.)?min(?=\\s*\\()|(?<![\\w.])(?:(?:numeric|mathjs|lodash|Math|math|d3|ss|tf|nj|_|R)\\.)?greatest(?=\\s*\\()|(?<![\\w.])(?:(?:numeric|mathjs|lodash|Math|math|d3|ss|tf|nj|_|R)\\.)?least(?=\\s*\\()|(?<![\\w.])(?:(?:numeric|mathjs|lodash|Math|math|d3|ss|tf|nj|_|R)\\.)?matrix(?=\\s*\\(\\s*\\[)|(?<![\\w.])(?:(?:numeric|mathjs|lodash|Math|math|d3|ss|tf|nj|_|R)\\.)?tensor(?=\\s*\\(\\s*\\[)|(?<![\\w.])(?:(?:numeric|mathjs|lodash|Math|math|d3|ss|tf|nj|_|R)\\.)?tensor2d(?=\\s*\\(\\s*\\[)",
      "name": "support.function.mathview meta.mathview.tall"
    },
    {
      "match": "(?<=\\.)reduce(?:Right)?(?=\\s*\\()",
      "name": "support.function.mathview meta.mathview.tall"
    },
    {
      "match": "(?<=[\\w$)\\]])\\s*/(?![/=*])(?=[^\\n]*[^/*]/[^/=*])",
      "name": "keyword.operator.arithmetic.mathview meta.mathview.tall"
    },
    {
      "match": "(?<= )\\?(?= )",
      "name": "keyword.operator.ternary.mathview meta.mathview.tall"
    },
    {
      "match": "(?<![\\w.])(?:(?:numeric|mathjs|lodash|Math|math|d3|ss|tf|nj|_|R)\\.)?(?:all|any)(?=\\s*\\([^\\n]*\\bfor\\b)",
      "name": "support.function.mathview meta.mathview.medium"
    },
    {
      "match": "(?<![\\w.])(?:(?:numeric|mathjs|lodash|Math|math|d3|ss|tf|nj|_|R)\\.)?every(?=\\s*\\()|(?<![\\w.])(?:(?:numeric|mathjs|lodash|Math|math|d3|ss|tf|nj|_|R)\\.)?some(?=\\s*\\()|(?<![\\w.])(?:(?:numeric|mathjs|lodash|Math|math|d3|ss|tf|nj|_|R)\\.)?zScore(?=\\s*\\()|(?<![\\w.])(?:(?:numeric|mathjs|lodash|Math|math|d3|ss|tf|nj|_|R)\\.)?divide(?=\\s*\\()|(?<![\\w.])(?:(?:numeric|mathjs|lodash|Math|math|d3|ss|tf|nj|_|R)\\.)?combinations(?=\\s*\\()|(?<=\\.)every(?=\\s*\\()|(?<=\\.)some(?=\\s*\\()|(?<=\\.)div(?=\\s*\\()",
      "name": "support.function.mathview meta.mathview.medium"
    },
    {
      "match": "(?<=[\\w$)\\]])\\s*/(?![/=*])",
      "name": "keyword.operator.arithmetic.mathview meta.mathview.medium"
    }
  ]
}
