{
  "scopeName": "mathview.julia",
  "injectionSelector": "L:source.julia -comment -string",
  "comment": "Generated by Math View from its notation settings. Do not edit.",
  "patterns": [
    {
      "match": "(?<![\\w.])(?:(?:LinearAlgebra|Base)\\.)?(?:prod|sum)(?=\\s*\\([^\\n]*\\bfor\\b)",
      "name": "support.function.mathview meta.mathview.tall"
    }
  ]
}
